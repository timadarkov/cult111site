# Local development template. Never insert real credentials into this tracked file.
DB_USER=cult111_local
DB_PASSWORD=
DB_NAME=cult111_local
DB_HOST=postgres
DB_DIRECT_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
ENVIRONMENT=local
HOST_URL=["http://localhost:5000","http://localhost:5001"]
CORS_ORIGINS=["http://localhost:5000","http://localhost:5001"]

# Dummy settings allow initialization; uploads need a real development R2 bucket.
R2_ENDPOINT=https://example.invalid
R2_ACCESS_KEY_ID=local-placeholder
R2_SECRET_ACCESS_KEY=local-placeholder
R2_BUCKET=cult111-local
R2_PUBLIC_URL=https://example.invalid
IMAGE_MAX_SIZE=5242880

# Nginx is not required by the documented local API workflow.
SERVER_NAME=localhost
STOREFRONT_PATH=/absolute/path/to/store111front
ADMIN_PATH=/absolute/path/to/adminfront111
